# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated extra CSRF trusted origins (scheme + host, no path)
CSRF_TRUSTED_ORIGINS=

# Database (PostgreSQL 15+ with the pgvector extension available).
# TCP example:  postgresql://postgres:postgres@localhost:5432/aitools
# Socket example (unix domain socket dir in the query string):
#               postgresql://postgres:@/aitools?host=/home/user/pgdata
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aitools

# Frontend origin(s) allowed by CORS (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex list, e.g. to allow a sandbox preview host:
# CORS_ALLOWED_ORIGIN_REGEXES=https://.*\.e2b\.app

# JWT
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# Backend used to produce 384-dim vectors:
#   auto                 -> try sentence-transformers, fall back to hash (default)
#   sentence-transformers-> all-MiniLM-L6-v2 (needs network on first use)
#   hash                 -> deterministic offline numpy embedder (tests / demos)
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
# How embedding jobs are dispatched off the request path:
#   auto   -> Celery if USE_CELERY=1, otherwise a background thread pool
#   celery -> always Celery (requires a running worker)
#   sync   -> run immediately (tests only — never use in production!)
EMBEDDING_DISPATCH=auto

# Hybrid search blend: weight of full-text rank vs (1 - w) semantic similarity
SEARCH_TEXT_WEIGHT=0.4

# Background jobs (optional)
USE_CELERY=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ---------------------------------------------------------------------------
# Live multi-model chat (Model Lab) — REAL PAID APIs, spend real money.
# Set a spend cap in each provider's dashboard before running live demos.
# A missing key is surfaced honestly as "not connected" — never faked.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# Optional: override the vendor-side model per provider (defaults in
# chat/providers.py REGISTRY; new model releases = one env var, no code)
OPENAI_CHAT_MODEL=
ANTHROPIC_CHAT_MODEL=
GEMINI_CHAT_MODEL=
GEMINI_CHAT_MODEL_LITE=
GROQ_CHAT_MODEL=
GROQ_CHAT_MODEL_8B=
GROQ_CHAT_MODEL_GEMMA2=
# BYOK encryption: users may paste their OWN provider keys in Model Lab —
# stored Fernet-encrypted. Derived from SECRET_KEY unless set explicitly
# (rotating this value invalidates stored user keys; they just re-paste).
CHAT_KEY_ENCRYPTION_SECRET=
# Safety caps per streamed response
CHAT_TIMEOUT_SECONDS=60
CHAT_MAX_TOKENS=512
